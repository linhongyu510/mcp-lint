{
  "tools": [
    {
      "name": "get_weather",
      "description": "Return the current weather for a city by name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "city": { "type": "string" },
          "units": { "type": "string", "enum": ["metric", "imperial"] }
        },
        "required": ["city"],
        "additionalProperties": false
      }
    },
    {
      "name": "convert_currency",
      "description": "Convert an amount from one currency to another using published daily rates.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount": { "type": "number", "minimum": 0 },
          "from": { "type": "string" },
          "to": { "type": "string" }
        },
        "required": ["amount", "from", "to"],
        "additionalProperties": false
      }
    }
  ]
}
